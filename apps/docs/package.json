{
  "name": "@vincle/docs",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun docs-src/dev-server.ts",
    "build": "bun run build:vite && bun run build:ssg",
    "build:vite": "vite build",
    "build:ssg": "bun docs-src/build.tsx",
    "preview": "vite preview --outDir dist",
    "format": "oxfmt",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@vincle/core": "workspace:*",
    "@vincle/flow": "workspace:*",
    "@vincle/vite-plugin": "workspace:*",
    "gray-matter": "^4.0.3",
    "satteri": "^0.9.5",
    "satteri-expressive-code": "^0.1.24",
    "vite-plugin-satteri": "^0.2.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
