playground

# Benchmark output — machine- and moment-specific by nature, and comparing a
# baseline recorded elsewhere is exactly the measurement error to avoid. The
# gate's floor is a build, not a measurement: `apps/bench/reference/` is
# versioned, and nothing in `results/` is. CI creates the directory itself.
apps/bench/results/

# CPU profiles — a diagnostic, tied to one machine and one moment.
*.cpuprofile

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# opencode agent workspace — installed locally, never part of the repo
.opencode/
