{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#check:static": { "cache": false },
    "//#check:scripts": { "cache": false },
    "//#check:ci": { "cache": false },
    "//#check:published-types": {
      "dependsOn": ["@vincle/core#build", "@vincle/flow#build"],
      "inputs": ["scripts/check-published-types.ts", "tests/published-types/**", "bun.lock"],
      "outputs": []
    },
    "//#check:packed": {
      "dependsOn": [
        "@vincle/core#build",
        "@vincle/flow#build",
        "@vincle/precompile#build",
        "@vincle/ssg#build",
        "@vincle/vite-plugin#build",
        "@vincle/eslint-plugin#build",
        "create-vincle#build"
      ],
      "cache": false
    },
    "//#oxlint": { "dependsOn": ["@vincle/eslint-plugin#build"], "cache": false },
    "mutation": {
      "dependsOn": ["^build"],
      "outputs": ["reports/**"]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "badges/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "format": {
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "bench:stats": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "conformance": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "bench:flow": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "@vincle/ssg#test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    }
  }
}
