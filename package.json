{
  "name": "@vincle/vincle",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@vincle/flow": "workspace:*",
      "@vincle/vite-plugin": "workspace:*",
      "@vincle/precompile-core": "workspace:*",
      "@vincle/precompile": "workspace:*",
      "@vincle/eslint-plugin": "workspace:*",
      "@iconify-icons/tabler": "^1.2",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.1",
      "@types/react": "^19.3.0",
      "bun": "^1.4.2",
      "eslint": "^10.10.0",
      "gray-matter": "^4.0.3",
      "tsdown": "^0.22.14",
      "shiki": "^4",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "@typescript-eslint/parser": "^8.70.0",
      "@typescript-eslint/utils": "^8.69.0",
      "@typescript-eslint/rule-tester": "^8.70.0",
      "unified": "^11",
      "vite": "^8.3.0",
      "vite-plugin-dts": "^5",
      "zod": "^4",
      "csstype": "^3.2.3",
      "oxc-parser": "^0.150.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "dev": "turbo run dev",
    "format": "turbo format",
    "lint": "turbo run build --filter=@vincle/eslint-plugin && oxlint .",
    "test": "turbo test",
    "test:coverage": "turbo run coverage"
  },
  "devDependencies": {
    "bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.13"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/node": "^26.4.1"
  },
  "packageManager": "bun@1.4.0"
}
