{
  "name": "@vincle/vincle",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@vincle/flow": "workspace:*",
      "@vincle/vite-plugin": "workspace:*",
      "@vincle/precompile-core": "workspace:*",
      "@vincle/vite-plugin-precompile": "workspace:*",
      "@vincle/eslint-plugin": "workspace:*",
      "@iconify-icons/tabler": "^1.2",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.4.0",
      "@types/node": "^22.20.1",
      "@types/react": "^19.2.18",
      "bun": "^1.4.0",
      "eslint": "^10.9.1",
      "fast-check": "^3.23.2",
      "gray-matter": "^4.0.3",
      "tsdown": "^0.22.14",
      "shiki": "^4",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "@typescript-eslint/parser": "^8.69.0",
      "@typescript-eslint/utils": "^8.69.0",
      "@typescript-eslint/rule-tester": "^8.69.0",
      "unified": "^11",
      "vite": "^8.2.2",
      "vite-plugin-dts": "^5",
      "zod": "^4"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "dev": "turbo run dev",
    "format": "turbo format",
    "lint": "turbo run build --filter=@vincle/eslint-plugin && oxlint .",
    "test": "turbo test",
    "test:coverage": "turbo run coverage"
  },
  "devDependencies": {
    "@oxc-project/types": "^0.139.0",
    "bun": "^1.4.0",
    "lefthook": "^2.1.12",
    "oxc-parser": "^0.139.0",
    "oxc-transform": "^0.139.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
