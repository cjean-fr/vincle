{
  "name": "@vincle/vincle",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@vincle/flow": "workspace:*",
      "@vincle/vite-plugin": "workspace:*",
      "@vincle/precompile": "workspace:*",
      "@vincle/eslint-plugin": "workspace:*",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.4",
      "@types/react": "^19.3.0",
      "bun": "^1.4.2",
      "eslint": "^10.12.0",
      "gray-matter": "^4.0.3",
      "tsdown": "^0.23.0",
      "oxfmt": "^0.72.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "@typescript-eslint/parser": "^8.71.1",
      "@typescript-eslint/rule-tester": "^8.71.1",
      "vite": "^8.3.2",
      "zod": "^4",
      "csstype": "^3.2.3",
      "oxc-parser": "^0.153.0",
      "@stryker-mutator/core": "^10.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bun run check:static && tsc -p scripts/tsconfig.json && bun test scripts/check-static.test.ts && turbo check",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "lint": "turbo run build --filter=@vincle/eslint-plugin && oxlint .",
    "test": "turbo test",
    "test:coverage": "turbo run coverage",
    "check:static": "bun scripts/check-static.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun": "^1.4.2",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
