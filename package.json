{
  "name": "@vincle/vincle",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@vincle/flow": "workspace:*",
      "@vincle/vite-plugin": "workspace:*",
      "@vincle/precompile-core": "workspace:*",
      "@vincle/vite-plugin-precompile": "workspace:*",
      "@vincle/eslint-plugin": "workspace:*",
      "@iconify-icons/tabler": "1.2",
      "@tailwindcss/vite": "4.2.4",
      "@types/bun": "1.3.0",
      "@types/node": "20.19.40",
      "@types/react": "19.1.10",
      "bun": "1.3.0",
      "eslint": "10.0.0",
      "fast-check": "4.7.0",
      "gray-matter": "4.0.3",
      "tsdown": "0.14.1",
      "shiki": "4.0.2",
      "tailwindcss": "4.2.4",
      "typescript": "6.0.2",
      "@typescript-eslint/parser": "8.56.0",
      "@typescript-eslint/utils": "8.56.0",
      "@typescript-eslint/rule-tester": "8.56.0",
      "unified": "11",
      "vite": "8.0.11",
      "vite-plugin-dts": "5",
      "zod": "4"
    }
  },
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "dev": "turbo run dev",
    "format": "turbo format",
    "lint": "turbo run build --filter=@vincle/eslint-plugin && oxlint .",
    "test": "turbo test",
    "test:coverage": "turbo run coverage"
  },
  "devDependencies": {
    "@oxc-project/types": "0.92.0",
    "bun": "1.3.0",
    "lefthook": "1.13.4",
    "lint-staged": "16.2.0",
    "oxc-parser": "0.92.0",
    "oxc-transform": "0.92.0",
    "oxfmt": "0.32.0",
    "oxlint": "1.47.0",
    "tailwindcss": "4.2.4",
    "turbo": "2.8.9"
  },
  "peerDependencies": {
    "typescript": "6.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.3.0"
}
