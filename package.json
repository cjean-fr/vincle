{
  "name": "@vincle/vincle",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@vincle/flow": "workspace:*",
      "@vincle/vite-plugin": "workspace:*",
      "@vincle/precompile": "workspace:*",
      "@vincle/eslint-plugin": "workspace:*",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.4.3",
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "bun": "^1.4.3",
      "eslint": "^10.13.0",
      "gray-matter": "^4.0.3",
      "tsdown": "^0.23.1",
      "oxfmt": "^0.72.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "@typescript-eslint/parser": "^8.72.0",
      "@typescript-eslint/rule-tester": "^8.72.0",
      "vite": "^8.3.4",
      "zod": "^4",
      "csstype": "^3.2.3",
      "oxc-parser": "^0.153.0",
      "@stryker-mutator/core": "^10.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bun run check:static && bun check -p scripts/tsconfig.json && bun run check:ci && turbo check && bun run check:published && bun run check:packed",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "lint": "turbo run build --filter=@vincle/eslint-plugin && oxlint .",
    "test": "turbo test",
    "test:coverage": "turbo run coverage",
    "check:static": "bun scripts/check-static.ts",
    "check:ci": "bun scripts/check-workflows.ts && bun test scripts",
    "check:published": "turbo run build --filter=@vincle/core --filter=@vincle/flow && bun scripts/check-published-types.ts",
    "check:packed": "turbo run build --filter=./packages/* && bun scripts/check-packed.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun": "^1.4.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.9"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.3"
}
