{
  "name": "@vincle/vincle",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@types/bun": "1.2.20",
      "@types/react": "19.1.10",
      "tsdown": "0.14.1",
      "typescript": "5.9.2"
    }
  },
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "dev": "turbo run dev",
    "format": "turbo format",
    "test": "turbo test"
  },
  "devDependencies": {
    "@oxc-project/types": "0.92.0",
    "lefthook": "1.13.4",
    "lint-staged": "16.2.0",
    "oxc-parser": "0.92.0",
    "oxc-transform": "0.92.0",
    "oxfmt": "0.3.0",
    "oxlint": "1.18.0",
    "turbo": "2.5.6"
  },
  "peerDependencies": {
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.1.30"
}
