{
  "name": "@vincle/vincle",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@vincle/core": "workspace:*",
      "@vincle/flow": "workspace:*",
      "@vincle/vite-plugin": "workspace:*",
      "@vincle/precompile-core": "workspace:*",
      "@vincle/vite-plugin-precompile": "workspace:*",
      "@vincle/eslint-plugin": "workspace:*",
      "@types/bun": "1.3.0",
      "@types/react": "19.1.10",
      "bun": "1.3.0",
      "eslint": "10.0.0",
      "tsdown": "0.14.1",
      "typescript": "6.0.2",
      "@typescript-eslint/parser": "8.56.0",
      "@typescript-eslint/utils": "8.56.0",
      "@typescript-eslint/rule-tester": "8.56.0",
      "vite": "6.4.2",
      "vite-plugin-dts": "5"
    }
  },
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "dev": "turbo run dev",
    "format": "turbo format",
    "lint": "turbo run build --filter=@vincle/eslint-plugin && oxlint .",
    "test": "turbo test"
  },
  "devDependencies": {
    "@oxc-project/types": "0.92.0",
    "bun": "1.3.0",
    "lefthook": "1.13.4",
    "lint-staged": "16.2.0",
    "oxc-parser": "0.92.0",
    "oxc-transform": "0.92.0",
    "oxfmt": "0.13.0",
    "oxlint": "1.28.0",
    "turbo": "2.6.1"
  },
  "peerDependencies": {
    "typescript": "6.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.3.0"
}
