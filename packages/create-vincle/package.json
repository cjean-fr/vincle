{
  "name": "create-vincle",
  "version": "0.9.0",
  "description": "Interactive project bootstrapper for Vincle with Bun, Deno, and Node templates",
  "keywords": [
    "bootstrap",
    "bun",
    "create-vincle",
    "deno",
    "node",
    "scaffold",
    "starter",
    "vincle"
  ],
  "homepage": "https://vincle.cjean.fr",
  "bugs": {
    "url": "https://github.com/cjean-fr/vincle/issues"
  },
  "license": "MIT",
  "author": "Christophe Jean",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjean-fr/vincle.git",
    "directory": "packages/create-vincle"
  },
  "bin": {
    "create-vincle": "./dist/launcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "format": "oxfmt",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
