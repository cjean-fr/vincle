{
  "name": "@vincle/core",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "bun": "./index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./html": {
      "types": "./src/html.ts",
      "bun": "./src/html.ts",
      "import": "./dist/html.mjs",
      "default": "./dist/html.mjs"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "bun": "./src/jsx-runtime.ts",
      "import": "./dist/jsx-runtime.mjs",
      "default": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-dev-runtime.ts",
      "bun": "./src/jsx-dev-runtime.ts",
      "import": "./dist/jsx-dev-runtime.mjs",
      "default": "./dist/jsx-dev-runtime.mjs"
    },
    "./jsx-precompile-runtime": {
      "types": "./src/jsx-precompile-runtime.ts",
      "bun": "./src/jsx-precompile-runtime.ts",
      "import": "./dist/jsx-precompile-runtime.mjs",
      "default": "./dist/jsx-precompile-runtime.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "format": "oxfmt",
    "mutation": "stryker run",
    "test": "bun test"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "stryker-mutator-bun-runner": "^0.4.0",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
