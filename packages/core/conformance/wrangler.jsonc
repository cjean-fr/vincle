{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vincle-core-conformance",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  // `nodejs_compat` is the subject here, not a configuration detail: it is what
  // gives workerd `AsyncLocalStorage`, and so what decides whether `@vincle/core`
  // isolates concurrent scopes or refuses to tell them apart.
  "compatibility_flags": ["nodejs_compat"],
}
