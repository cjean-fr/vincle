{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "mutate": [
    "src/create-element.ts",
    "src/create-element-async.ts",
    "src/attrs.ts",
    "src/escape.ts",
    "src/context.ts",
    "src/raw.ts",
    "src/serialize.ts",
    "src/static-render.ts",
    "src/url-safety.ts",
    "src/render-chunks.ts",
    "src/jsx-runtime.ts",
    "src/jsx-dev-runtime.ts",
    "src/jsx-precompile-runtime.ts"
  ],
  "mutator": {
    "excludedMutations": ["BlockStatement"]
  },
  "concurrency": 4,
  "coverageAnalysis": "off",
  "reporters": ["html", "clear-text", "progress"],
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 65
  },
  "timeoutMS": 30000
}
