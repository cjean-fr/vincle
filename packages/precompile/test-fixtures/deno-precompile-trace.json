{
  "source": "deno 2.9.6 (stable, release, x86_64-unknown-linux-gnu)",
  "prelude": "const c = \"C\"; const f = \"F\"; const b = true; const h = \"H\"; const a = \"A\";\nconst d = \"D\"; const s = \"S\"; const name = \"N\"; const css = \"CSS\";\nconst p = { z: 1 };\nconst Foo = (q) => null;\nconst Ctx = { Provider: (q) => null };",
