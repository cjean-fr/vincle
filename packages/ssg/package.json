{
  "name": "@vincle/ssg",
  "version": "0.3.2",
  "description": "File-based static generation with extensible content handlers and multiple outputs",
  "keywords": [
    "generator",
    "ssg",
    "static-site",
    "vincle"
  ],
  "homepage": "https://vincle.cjean.fr",
  "bugs": {
    "url": "https://github.com/cjean-fr/vincle/issues"
  },
  "license": "MIT",
  "author": "Christophe Jean",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjean-fr/vincle.git",
    "directory": "packages/ssg"
  },
  "bin": {
    "ssg": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun check",
    "test": "bun test",
    "format": "oxfmt"
  },
  "dependencies": {
    "@vincle/core": "workspace:*",
    "@vincle/vite-plugin": "workspace:*",
    "esbuild": "^0.28.2",
    "gray-matter": "catalog:",
    "satteri": "^0.10.5",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  }
}
