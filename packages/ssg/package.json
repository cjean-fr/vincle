{
  "name": "@vincle/ssg",
  "version": "0.6.0",
  "description": "File-based static generation with extensible content handlers and multiple outputs",
  "keywords": [
    "generator",
    "ssg",
    "static-site",
    "vincle"
  ],
  "homepage": "https://vincle.cjean.fr",
  "bugs": {
    "url": "https://github.com/cjean-fr/vincle/issues"
  },
  "license": "MIT",
  "author": "Christophe Jean",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjean-fr/vincle.git",
    "directory": "packages/ssg"
  },
  "bin": {
    "ssg": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun check && bun check -p tsconfig.tests.json",
    "test": "bun test",
    "format": "oxfmt"
  },
  "dependencies": {
    "@vincle/core": "workspace:^",
    "@vincle/vite-plugin": "workspace:^",
    "gray-matter": "catalog:",
    "satteri": "^0.10.5",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "satori": "^0.63.2",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "satori": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
